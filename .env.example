# =============================================================
# ScholarFlow — environment template
# Copy to .env.local and fill in the real values.
# =============================================================

# -------------------------------------------------------------
# Clerk (https://dashboard.clerk.com -> your app -> API Keys)
# REQUIRED for sign-in / sign-up / dashboard to work.
# -------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Clerk route mapping (defaults are already correct for this app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# -------------------------------------------------------------
# Database (PostgreSQL, e.g. Neon) — REQUIRED for Prisma
# -------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require

# -------------------------------------------------------------
# App
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
