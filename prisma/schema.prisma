generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum BlockType {
  NOTE
  TRANSCRIPT
  STUDY_MATERIAL
}

enum ArtifactType {
  CHAT
  SUMMARY
  QUIZ
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships WorkspaceMember[]
  todos       Todo[]
  chats       ChatHistory[]

  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   WorkspaceMember[]
  documents Document[]
  columns   TaskColumn[]
  decks     FlashcardDeck[]
  chats     ChatHistory[]
  todos     Todo[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String     @id @default(uuid())
  userId      String
  workspaceId String
  role        MemberRole @default(MEMBER)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // A user can only have one membership record per workspace
  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

model Document {
  id          String           @id @default(uuid())
  workspaceId String
  title       String
  storagePath String // e.g., S3 or UploadThing URL
  fileType    String?
  sizeBytes   Int?
  status      ProcessingStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blocks            ContentBlock[]
  embeddings        EmbeddingsMetadata[]
  transcriptionJobs TranscriptionJob[]

  @@map("documents")
}

model ContentBlock {
  id         String    @id @default(uuid())
  documentId String
  type       BlockType
  content    Json // Stores TipTap JSON, transcript segments, etc.
  order      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("content_blocks")
}

model EmbeddingsMetadata {
  id               String   @id @default(uuid())
  documentId       String
  pineconeVectorId String   @unique
  chunkText        String   @db.Text
  createdAt        DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("embeddings_metadata")
}

model ChatHistory {
  id           String       @id @default(uuid())
  workspaceId  String
  userId       String
  query        String       @db.Text
  response     String       @db.Text // Can store markdown/JSON for artifacts
  artifactType ArtifactType @default(CHAT)
  createdAt    DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_history")
}

model TranscriptionJob {
  id         String           @id @default(uuid())
  documentId String
  status     ProcessingStatus @default(PENDING)
  error      String?          @db.Text
  providerId String? // ID from Whisper/external API
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("transcription_jobs")
}

model TaskColumn {
  id          String   @id @default(uuid())
  workspaceId String
  title       String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@map("task_columns")
}

model Task {
  id          String   @id @default(uuid())
  columnId    String
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  column TaskColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model FlashcardDeck {
  id          String   @id @default(uuid())
  workspaceId String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]

  @@map("flashcard_decks")
}

model Flashcard {
  id     String @id @default(uuid())
  deckId String
  front  String @db.Text
  back   String @db.Text

  // Spaced-repetition state (SuperMemo-2 style)
  nextReviewDate DateTime @default(now())
  easeFactor     Float    @default(2.5) // SuperMemo default
  interval       Int      @default(0) // Days until next review
  repetitions    Int      @default(0) // Times successfully recalled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deck FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@map("flashcards")
}

model Todo {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  title       String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("todos")
}
